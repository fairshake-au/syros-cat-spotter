{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testDatabase": "./src/migrate/testDatabase.ts",
    "./fold": "./src/fold.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "tsx ./src/migrate/cli.ts up",
    "migrate:rollback": "tsx ./src/migrate/cli.ts rollback",
    "migrate:cycle": "tsx ./src/migrate/cli.ts cycle",
    "migrate:check": "tsx ./src/migrate/cli.ts check",
    "smoke": "tsx ./src/migrate/cli.ts smoke",
    "switchover": "tsx ./src/switchover/cli.ts",
    "test": "vitest run",
    "people": "tsx ./src/people/cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
