<script data-dc-script data-props='{"$preview":{"width":1440,"height":2500}}'>
class Component extends DCLogic {
  constructor(props) {
    super(props);
    this.state = { lang: 'en', email: '', done: false, err: false };
  }

  copy() {
    return {
      en: {
        label: 'EN',
        eyebrow: 'Syros · Cyclades · Greece',
        h1: 'Help the cats of Syros live better lives.',
        sub: 'Photograph a cat in the alleys of Ermoupoli and the app works out who it is. Locals and visitors are building one shared record of every cat on the island.',
