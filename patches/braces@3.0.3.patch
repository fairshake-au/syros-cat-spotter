diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..ba0c35aa0f379f34370a26a834f5c19bad260423
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,24 @@
+'use strict';
+
+// Only follow child nodes, not the parser's parent/prev back references.
+// Iteration makes validating attacker-supplied ASTs independent of call-stack size.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (depth > 128) {
+      throw new SyntaxError('Brace AST exceeds maximum nesting depth (128)');
+    }
+    if (!node || typeof node !== 'object') continue;
+    if (seen.has(node)) {
+      throw new SyntaxError('Brace AST contains repeated or cyclic child nodes');
+    }
+    seen.add(node);
+    if (node.nodes) {
+      for (const child of node.nodes) {
+        pending.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
