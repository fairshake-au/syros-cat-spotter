{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catspotters-coming-soon",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "catspotters.com", "custom_domain": true },
    { "pattern": "www.catspotters.com", "custom_domain": true }
  ],
  // Per-IP throttles. The password gate is a single shared secret, so an
  // unlimited number of free guesses was the whole security model's weak point.
  "unsafe": {
    "bindings": [
      { "name": "UNLOCK_RL", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
      { "name": "SUBSCRIBE_RL", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
    ]
  },
  // The documents must never be reachable as static assets, even if somebody
  // later drops a file into public/ with a matching name.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/media", "/forpurpose", "/boundless"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catspotters-signups",
      "database_id": "875b34ad-1c2d-4297-8dca-2041e7261a05"
    }
  ]
}
