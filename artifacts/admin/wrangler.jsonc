{
  "$schema": "node_modules/wrangler/config-schema.json",
  // admin.catspotters.com — the shared Syros Cats / Fair Shake workspace.
  // Shares the D1 database and the signing key with the public site, so a
  // link minted here is trusted there.
  "name": "catspotters-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "admin.catspotters.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catspotters-signups",
      "database_id": "875b34ad-1c2d-4297-8dca-2041e7261a05"
    }
  ]
}
