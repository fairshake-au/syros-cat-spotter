    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/welfare-guidance": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "heic-convert": "^2.1.0",
    "multer": "^2.5.0",
    "onnxruntime-node": "1.21.0",
    "pino": "^9.14.0",
