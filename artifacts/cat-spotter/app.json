{
  "expo": {
    "name": "Syros Cat Spotter",
    "slug": "cat-spotter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cat-spotter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Syros Cat Spotter uses your location to record where cats are seen and to show cats near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Syros Cat Spotter needs access to your photos so you can submit cat sightings.",
          "cameraPermission": "Syros Cat Spotter uses the camera to photograph cats you spot."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
