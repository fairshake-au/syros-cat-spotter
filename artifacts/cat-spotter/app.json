{
  "expo": {
    "name": "Syros Cat Spotters",
    "slug": "syroscatspotters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "syroscatspotters",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.syroscatspotters.app"
    },
    "android": {
      "package": "com.syroscatspotters.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Syros Cat Spotter uses the camera to photograph cats you spot.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Syros Cat Spotter uses your location to record where cats are seen and to show cats near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Syros Cat Spotter needs access to your photos so you can submit cat sightings.",
          "cameraPermission": "Syros Cat Spotter uses the camera to photograph cats you spot.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}